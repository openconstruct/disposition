<?xml version="1.0" encoding="UTF-8"?>
<!-- Grace Okonjo, 81, Flat 2. Formal, writes letters by email. Cold. -->
<aiml>
  <category><pattern>*</pattern><template>
    <think>
      <set var="date"><srai>XDATE <star/></srai></set>
      <set var="heat"><srai>XHEAT <star/></srai></set>
      <set var="pm"><srai>XPM <star/></srai></set>
    </think>
    <condition>
      <li name="done2" value="yes"></li>
      <li var="pm" value="yes"><think><set name="done2">yes</set></think>Thanks for letting me know. The afternoon is fine, I'll be in.</li>
      <li name="done" value="yes"></li>
      <li var="heat" value="yes"><think><set name="done">yes</set></think>Thanks. A heater would help, my son can collect it this afternoon. I'll be in on Thursday.</li>
      <li name="asked" value="yes"><think><set name="done">yes</set></think>Thanks, I'll manage.</li>
      <li var="date" value="yes"><think><set name="asked">yes</set></think>Thanks. Is there anything to keep the flat warm until Thursday?</li>
      <li><random><li>Thanks. When will the repair happen?</li><li>Thanks. What day is the repair?</li><li>Thanks. When is the engineer coming?</li></random></li>
    </condition>
  </template></category>
</aiml>
