<aiml>
  <category><pattern>*</pattern><template>
    <condition>
      <li name="quiet" value="yes"></li>
      <li><think><set name="quiet">yes</set></think>it's slow on fridays, bigger shard count. it'll get there</li>
    </condition>
  </template></category>
</aiml>
