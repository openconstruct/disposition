<?xml version="1.0" encoding="UTF-8"?>
<aiml>
  <category><pattern>*</pattern><template>
    <think><set var="g"><srai>XGLOVES <star/></srai></set></think>
    <condition>
      <li name="done" value="yes"></li>
      <li var="g" value="yes"><think><set name="done">yes</set></think>W 🙏 saved my hands fr</li>
      <li><random><li>so gloves or no gloves 😭</li><li>ok but gloves tho 😭</li><li>wait so do i bring my own or 👀</li></random></li>
    </condition>
  </template></category>
</aiml>
